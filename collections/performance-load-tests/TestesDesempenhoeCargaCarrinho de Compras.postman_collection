		{
			"name": "Login no Sistema - Válido",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response time is less than 200ms\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Mensagem para Login realizado com sucesso\", function () {\r",
							"    pm.expect(pm.response.text()).to.include(\"Login realizado com sucesso\");\r",
							"});\r",
							"\r",
							"pm.collectionVariables.set(\"authtoken\", pm.response.json().authorization);\r",
							"\r",
							"const token = pm.collectionVariables.get(\"authtoken\");\r",
							"pm.test(\"JWT com estrutura OK\", function () {\r",
							"    pm.expect(token).to.not.be.undefined;\r",
							"    pm.expect(token).to.match(/^Bearer\\s[\\w-]+\\.[\\w-]+\\.[\\w-]+$/);\r",
							"\r",
							"    const jwt = token.replace(\"Bearer \", \"\").split(\".\");\r",
							"\r",
							"    pm.expect(jwt.length).to.eql(3);\r",
							"    pm.expect(jwt[0].length).to.above(30);  // header\r",
							"    pm.expect(jwt[2].length).to.above(40);  // signature\r",
							"\r",
							"    const base64 = jwt[1].replace(/-/g, '+').replace(/_/g, '/');\r",
							"    const decodedPayload = JSON.parse(atob(base64));\r",
							"\r",
							"    // Verifica presença de campos obrigatórios\r",
							"    pm.expect(decodedPayload).to.have.property(\"email\");\r",
							"    pm.expect(decodedPayload.email).to.match(/^[^@]+@[^@]+\\.[a-zA-Z]{2,}$/);\r",
							"\r",
							"    pm.expect(decodedPayload).to.have.property(\"iat\");\r",
							"    pm.expect(decodedPayload).to.have.property(\"exp\");\r",
							"    pm.expect(decodedPayload.exp).to.be.above(decodedPayload.iat);\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
